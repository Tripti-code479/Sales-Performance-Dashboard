model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Customers","Date","Products","Regions","Sales","Salespersons"]

annotation PBI_ProTooling = ["DevMode"]

ref table Customers
ref table Date
ref table Products
ref table Regions
ref table Sales
ref table Salespersons

ref cultureInfo en-US

